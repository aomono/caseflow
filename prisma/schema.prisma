generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum DealStatus {
  lead
  discussion
  expected
  active
  renewal
  closed
  lost
}

enum Probability {
  high
  mid
  low
}

enum BillingType {
  monthly
  lumpsum
  prorated
}

enum ProrateBase {
  fixed30
  calendar
  business
}

enum ContactRole {
  admin
  buyer
  other
}

enum ActivityType {
  meeting
  email
  phone
  note
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

enum ReportStatus {
  draft
  finalized
}

enum ReminderType {
  payment
  invoice
  report
  renewal
  custom
}

enum ReminderStatus {
  pending
  reminded
  completed
}

enum NotificationChannel {
  slack
  email
}

// ─── Models ──────────────────────────────────────────────

model Client {
  id         String   @id @default(cuid())
  name       String
  industry   String?
  referredBy String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deals Deal[]
}

model Deal {
  id                  String     @id @default(cuid())
  clientId            String
  client              Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title               String
  status              DealStatus @default(lead)
  monthlyAmount       Int?
  billingType         BillingType @default(monthly)
  contractAmount      Int?
  prorateBase         ProrateBase?
  contractStartDate   DateTime?
  contractEndDate     DateTime?
  renewalReminderDays Int        @default(30)
  description         String?    @db.Text
  contractSummary     String?    @db.Text

  // パイプライン管理（v1.1）。すべて任意なので既存データはそのまま通る
  probability         Probability?
  nextAction          String?
  nextActionDate      DateTime?
  source              String?
  // 最新Activityのdateを非正規化して持つ。鮮度バッジと stale 検索で毎回
  // Activity を集計しないため（一覧・ボードで全件に効くので効きが大きい）
  lastActivityAt      DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  contacts  DealContact[]
  activities Activity[]
  invoices  Invoice[]
  reports   Report[]
  reminders Reminder[]
}

model DealContact {
  id        String      @id @default(cuid())
  dealId    String
  deal      Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name      String
  role      ContactRole @default(other)
  title     String?
  email     String?
  phone     String?
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
}

model Activity {
  id        String       @id @default(cuid())
  dealId    String
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      ActivityType
  date      DateTime
  summary   String       @db.Text
  createdAt DateTime     @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  dealId      String
  deal        Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  amount      Int
  workingDays Int?
  baseDays    Int?
  invoiceDate DateTime?
  dueDate     DateTime
  status      InvoiceStatus @default(draft)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([dealId, year, month])
}

model Report {
  id              String       @id @default(cuid())
  dealId          String
  deal            Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  period          String
  workDescription String       @db.Text
  amount          Int
  pdfUrl          String?
  docxUrl         String?
  status          ReportStatus @default(draft)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([dealId, year, month])
}

model Reminder {
  id                 String         @id @default(cuid())
  dealId             String?
  deal               Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title              String
  type               ReminderType
  dueDate            DateTime
  reminderDaysBefore Int            @default(3)
  slackChannel       String?
  emailTo            String?
  status             ReminderStatus @default(pending)
  createdAt          DateTime       @default(now())

  notifications NotificationLog[]

  @@unique([dealId, type, dueDate])
}

model NotificationLog {
  id         String              @id @default(cuid())
  reminderId String
  reminder   Reminder            @relation(fields: [reminderId], references: [id])
  channel    NotificationChannel
  message    String              @db.Text
  sentAt     DateTime            @default(now())
}

/// 外部API（きおい連携等）のアクセストークン。
/// 平文は保存しない——DBのダンプが漏れてもトークンが使われないようにする。
/// 発行時に一度だけ本人へ渡し、以降は照合にハッシュを使う。
model ApiToken {
  id         String    @id @default(cuid())
  name       String                        // 誰に発行したか（ログの主体）
  tokenHash  String    @unique             // SHA-256（平文は持たない）
  lastUsedAt DateTime?
  revokedAt  DateTime?                     // 失効可能にする（仕様書 C-2）
  createdAt  DateTime  @default(now())
}

model AppSettings {
  id                  String   @id @default(cuid())
  companyName         String
  defaultSlackChannel String?
  defaultEmailTo      String?

  // 見込み金額の加重係数（確度別）。設定画面で変更できる
  probabilityHighRate Float    @default(0.8)
  probabilityMidRate  Float    @default(0.5)
  probabilityLowRate  Float    @default(0.2)
  // 案件の経路。改行区切りで持つ（選択式＋自由追記なので固定enumにしない）
  dealSources         String   @default("NTTD\nBCG\nENND\n既存クライアント紹介\n直接") @db.Text
  // 鮮度バッジの閾値（最終接触からの日数）。これ以上で黄／赤
  freshnessWarnDays   Int      @default(8)
  freshnessAlertDays  Int      @default(15)

  /// 売上実績のカットオーバー日（既定 FY26期首）。
  /// この日以降の過去月は「Invoiceがあるものだけ実績」＝請求書発行基準。
  /// これ以前は Deal ベースのフォールバックを残す（過去履歴の移行を強制しない）。
  revenueCutoverDate  DateTime @default(dbgenerated("'2026-06-01'::timestamp"))

  updatedAt           DateTime @updatedAt
}
